# Environment mode: development or production
NODE_ENV=development

# Express/Vite server port
PORT=3000

# Public URL used by the application
APP_URL=http://localhost:3000

# Set to true to disable Vite HMR and file watching
DISABLE_HMR=false

# Required for signing login session JWTs. Use a long random value in production.
JWT_SECRET=replace-with-a-long-random-secret

# Optional Google SMTP settings for real OTP email delivery.
# Leave blank to use the local simulated OTP delivery mode.
GOOGLE_SMTP_USER=
GOOGLE_SMTP_APP_PASSWORD=

# Optional; currently reserved for integrations that use Gemini.
GEMINI_API_KEY=
